{
  "name": "uuid-nanoid",
  "version": "1.5.4",
  "description": "A browser-friendly UUID and NanoID generator library",
  "main": "dist/uuid-nanoid.cjs",
  "module": "dist/uuid-nanoid.esm.js",
  "browser": "dist/uuid-nanoid.umd.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/uuid-nanoid.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/uuid-nanoid.cjs"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/uuid-nanoid.umd.cjs"
      },
      "default": "./dist/uuid-nanoid.esm.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:prod": "cross-env NODE_ENV=production rollup -c rollup.config.mjs",
    "release": "node scripts/release.mjs",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "prepare": "husky"
  },
  "keywords": [
    "uuid",
    "nanoid",
    "unique-id",
    "identifier",
    "browser"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuoSirius/uuid-nanoid.git"
  },
  "homepage": "https://github.com/GuoSirius/uuid-nanoid#readme",
  "bugs": {
    "url": "https://github.com/GuoSirius/uuid-nanoid/issues"
  },
  "dependencies": {
    "nanoid": "^5.1.16",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "inquirer": "^14.0.2",
    "rollup": "^4.62.2",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "standard-version": "^9.5.0"
  }
}
